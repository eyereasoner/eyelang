{
  "name": "eyeprolog",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.3.73",
  "description": "EyeProlog turns facts and rules into answers and proofs.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "eyeprolog": "./bin/eyeprolog.js"
  },
  "keywords": [
    "logic",
    "rules",
    "prolog",
    "reasoner",
    "proofs"
  ],
  "license": "MIT",
  "author": "Jos De Roo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/eyeprolog.git"
  },
  "homepage": "https://github.com/eyereasoner/eyeprolog#readme",
  "files": [
    "LICENSE.md",
    "README.md",
    "index.js",
    "index.d.ts",
    "playground.html",
    "bin",
    "src",
    "tools",
    "conformance-report.md",
    "the-art-of-eyeprolog.md",
    "why-eyeprolog.md",
    "book-assets",
    "examples",
    "test"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "generate": "node tools/extract-book-examples.mjs",
    "test:eyeprolog": "node test/run-all.mjs",
    "test:conformance": "node test/run-conformance.mjs",
    "test:iso-strict": "node test/run-iso-strict.mjs",
    "test:interop": "node test/run-interop.mjs",
    "test:openrulebench": "node test/run-openrulebench.mjs",
    "test:wg17": "node test/run-wg17.mjs",
    "test:examples": "node test/run-examples.mjs",
    "test:regression": "node test/run-regression.mjs",
    "test:regression:api": "node test/run-regression.mjs api",
    "test:regression:core": "node test/run-regression.mjs regression",
    "test:regression:docs": "node test/run-regression.mjs docs",
    "test:regression:white-box": "node test/run-regression.mjs white-box",
    "test:playground": "node test/run-playground.mjs",
    "wg17:upgrade": "node tools/upgrade-wg17.mjs",
    "report:wg17": "node tools/report-wg17-syntax-coverage.mjs",
    "report:wg17-syntax": "node tools/report-wg17-syntax-coverage.mjs",
    "preversion": "npm test && node test/run-conformance-report.mjs conformance-report.md",
    "postversion": "git push origin HEAD --follow-tags",
    "test:architecture": "node test/run-architecture.mjs"
  }
}
