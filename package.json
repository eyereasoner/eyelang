{
  "name": "eyelang",
  "version": "5.0.5",
  "description": "An experimental symbolic logic programming language using a practical Prolog subset.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/eyelang.git"
  },
  "type": "module",
  "bin": {
    "eyelang": "eyelang.js"
  },
