{
  "name": "eyeon",
  "version": "0.0.4",
  "description": "A symbolic logic programming language implementing a subset of Prolog, with query explanations and executable checks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/eyeon.git"
  },
  "type": "module",
  "bin": {
    "eyeon": "eyeon.js"
  },
  "scripts": {
    "test": "node --test",
    "test:conformance": "node --test test/conformance",
    "examples:update": "node scripts/example-goldens.js",
    "benchmark": "node benchmarks/run.js",
    "start": "node eyeon.js examples/socrates.pl",
    "version": "node scripts/sync-version.js"
  },
  "engines": {
    "node": ">=18"
  }
}
